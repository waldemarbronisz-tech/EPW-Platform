  "project": {
    "name": "GOSPODARKA WODNA - PRZYKLAD",
    "description": "feat/water-management commit 6 - a ready-made demo project exercising all 12 new water-management objects together: a water-utility connection and a rainwater tank as two sources into a three-way selector valve, a filter, a hydrofor (pump), a check valve, a flow meter, a manifold splitting into three irrigation zones (two sprinkler zones and one drip-line zone), a rain sensor and a pressure switch, plus a meter and a signal panel reading the project's own device registry.",
    "created_at": "2026-09-09T00:00:00.000Z",
    "modified_at": "2026-09-09T00:00:00.000Z"
  },
